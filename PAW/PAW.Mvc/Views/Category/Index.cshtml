@model IEnumerable<PAW2.Models.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Categories";
}

<h2 class="mb-4">Categories</h2>

<!-- Botón Crear -->
<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createModal">+ Create New </button>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Modified By</th>
            <th>LastModified</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>
                <td>@item.ModifiedBy</td>
                <td>@item.LastModified?.ToString("yyyy-MM-dd")</td>
                <td>
                    <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@item.CategoryId">Edit</button>
                    <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.CategoryId">Delete</button>
                </td>
            </tr>

            <!-- Modal Editar -->
            <div class="modal fade" id="editModal-@item.CategoryId" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Edit" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Category</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="CategoryId" value="@item.CategoryId" />
                                <div class="mb-3">
                                    <label>Name</label>
                                    <input name="CategoryName" class="form-control" value="@item.CategoryName" required />
                                </div>
                                <div class="mb-3">
                                    <label>Description</label>
                                    <input name="Description" class="form-control" value="@item.Description" />
                                </div>
                                <div class="mb-3">
                                    <label>ModifiedByr</label>
                                    <input name="ModifiedBy" class="form-control" value="@item.ModifiedBy" required />
                                </div>
                                <div class="mb-3">
                                    <label>LastModified</label>
                                    <input name="LastModified" class="form-control" value="@item.LastModified?.ToString("yyyy-MM-dd")" type="date" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save Changess</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal Eliminar -->
            <div class="modal fade" id="deleteModal-@item.CategoryId" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form asp-action="Delete" method="post">
                            <div class="modal-header">
                                <h5 class="modal-title">Delete Category</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="CategoryId" value="@item.CategoryId" />
                                <p>Are you sure you want to delete the category? <strong>@item.CategoryName</strong>?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">Delete</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>

<!-- Modal Crear -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Name</label>
                        <input name="CategoryName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <input name="Description" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>ModifiedBy</label>
                        <input name="ModifiedBy" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>LastModifiedn</label>
                        <input name="LastModified" class="form-control" type="date" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Create</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
