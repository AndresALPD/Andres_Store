@model IEnumerable<PAW2.Models.ViewModels.CatalogViewModel>

@{
    ViewData["Title"] = "Catalog";
}

<h2>Catalog</h2>

<div class="mb-3">
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal">+ Create New</button>
</div>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Identifier</th>
            <th>Name</th>
            <th>Description</th>
            <th>SKU</th>
            <th>Rating</th>
            <th>Created By</th>
            <th>Created Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Identifier</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Sku</td>
                <td>@item.Rating</td>
                <td>@item.CreatedBy</td>
                <td>@item.CreatedDate?.ToString("yyyy-MM-dd")</td>
                <td>
                    <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@item.Identifier">Edit</button>
                    <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Identifier">Delete</button>
                </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editModal-@item.Identifier" tabindex="-1" aria-labelledby="editModalLabel-@item.Identifier" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content bg-dark text-white">
                        <form asp-action="Edit" asp-controller="Catalog">
                            <div class="modal-header">
                                <h5 class="modal-title">Edit Catalog</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="Identifier" value="@item.Identifier" />
                                <div class="mb-3">
                                    <label>Name</label>
                                    <input class="form-control" name="Name" value="@item.Name" />
                                </div>
                                <div class="mb-3">
                                    <label>Description</label>
                                    <textarea class="form-control" name="Description">@item.Description</textarea>
                                </div>
                                <div class="mb-3">
                                    <label>SKU</label>
                                    <input class="form-control" name="Sku" value="@item.Sku" />
                                </div>
                                <div class="mb-3">
                                    <label>Rating</label>
                                    <input class="form-control" name="Rating" type="number" step="0.1" value="@item.Rating" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">Save changes</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteModal-@item.Identifier" tabindex="-1" aria-labelledby="deleteModalLabel-@item.Identifier" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content bg-dark text-white">
                        <form asp-action="Delete" asp-controller="Catalog">
                            <div class="modal-header">
                                <h5 class="modal-title">Delete Confirmation</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                Are you sure you want to delete "<strong>@item.Name</strong>"?
                                <input type="hidden" name="identifier" value="@item.Identifier" />
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </tbody>
</table>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content bg-dark text-white">
            <form asp-action="Create" asp-controller="Catalog">
                <div class="modal-header">
                    <h5 class="modal-title">Create Catalog</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Name</label>
                        <input class="form-control" name="Name" />
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea class="form-control" name="Description"></textarea>
                    </div>
                    <div class="mb-3">
                        <label>SKU</label>
                        <input class="form-control" name="Sku" />
                    </div>
                    <div class="mb-3">
                        <label>Rating</label>
                        <input class="form-control" name="Rating" type="number" step="0.1" />
                    </div>
                    <div class="mb-3">
                        <label>Created By</label>
                        <input class="form-control" name="CreatedBy" />
                    </div>
                    <div class="mb-3">
                        <label>Created Date</label>
                        <input class="form-control" name="CreatedDate" type="datetime-local" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">Create</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
