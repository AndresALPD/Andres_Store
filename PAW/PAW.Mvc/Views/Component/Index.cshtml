@model List<PAW2.Models.ViewModels.ComponentViewModel>

@{
    ViewData["Title"] = "Components";
}

<h2>Component List</h2>

<button class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#createModal">Crear nuevo</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Contenido</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var component in Model)
        {
            <tr>
                <td>@component.Id</td>
                <td>@component.Name</td>
                <td>@component.Content</td>
                <td>
                    <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editModal-@component.Id">Editar</button>
                    <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal-@component.Id">Eliminar</button>
                </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editModal-@component.Id" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-action="Edit" method="post">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Editar Componente</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="Id" value="@component.Id" />
                                <div class="mb-3">
                                    <label>Nombre</label>
                                    <input class="form-control" name="Name" value="@component.Name" />
                                </div>
                                <div class="mb-3">
                                    <label>Contenido</label>
                                    <input class="form-control" name="Content" value="@component.Content" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-primary" type="submit">Guardar</button>
                                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteModal-@component.Id" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <form asp-action="Delete" method="post">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Confirmar eliminación</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                ¿Estás seguro que deseas eliminar el componente <strong>@component.Name</strong>?
                                <input type="hidden" name="Id" value="@component.Id" />
                            </div>
                            <div class="modal-footer">
                                <button class="btn btn-danger" type="submit">Eliminar</button>
                                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
    </tbody>
</table>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="Create" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Crear Componente</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Nombre</label>
                        <input class="form-control" name="Name" />
                    </div>
                    <div class="mb-3">
                        <label>Contenido</label>
                        <input class="form-control" name="Content" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success" type="submit">Crear</button>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </form>
    </div>
</div>
